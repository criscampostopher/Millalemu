fitCellText($pdf, $xC3+1.2, $y + $rowH*8 + 1.0, ($xR-$xC3)-2.4, $rowH, $row['tipo_suelo'] ?? '', 'L', '', 7.5, 6);
// Verif (fila 9)
fitCellText($pdf, $xC3+1.2, $y + $rowH*9 + 1.0, ($xR-$xC3)-2.4, $rowH, $row['verif_permisos'] ?? '', 'L', '', 7.5, 6);
// Jornada (fila 10, justo debajo; si te queda muy abajo, lo movemos)
fitCellText($pdf, $xC3+1.2, $y + $rowH*10 + 1.0, ($xR-$xC3)-2.4, $rowH, $row['jornada'] ?? '', 'L', '', 8, 6);

$y = $y + $hAnte + 2.0;

// ====== CONSIDERACIONES IMPORTANTES Y MEDIDAS ======
headerBar($pdf, $L, $y, $W, 6.0, "Consideraciones importantes y medidas");
$y += 6.0;

// Caja con 4 renglones (como imagen)
$hCons = 28.0;
rect($pdf, $L, $y, $W, $hCons);
$lineH = $hCons / 4.0;
for($i=1;$i<=3;$i++){
  hline($pdf, $L, $y + $lineH*$i, $R);
}

// Textos (si no quieres texto aquÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­, comenta esto)
$lines = array_merge(wrapLines($row['consideraciones'] ?? ''), wrapLines($row['medidas'] ?? ''));
for($i=0;$i<4;$i++){
  $txt = $lines[$i] ?? '';
  // en la plantilla se ve como lÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­neas, pero aquÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­ permitimos texto igual
  fitCellText($pdf, $L+10, $y + $lineH*$i + 1.2, $W-12, $lineH, $txt, 'L', '', 7.5, 6);
  // numeraciÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³n 1.- 2.- ...
  cellText($pdf, $L+2, $y + $lineH*$i + 1.2, 8, $lineH, ($i+1).".-", 'L', 'B', 8);
}

$y = $y + $hCons + 2.0;

// ====== PLANO DE PENDIENTES Y ACTA ======
headerBar($pdf, $L, $y, $W, 6.0, "Plano de Pendientes y Acta de Intervencion");
$y += 6.0;

$hPlano = 88.0; // caja grande original (la dejamos tal cual)
rect($pdf, $L, $y, $W, $hPlano);

// Ancho de la tablita pequeña
$wTabla = 50.0;

// Calculamos la posición X para que quede pegada a la derecha (con 2mm de margen)
$xTablaDer = ($L + $W) - $wTabla - 2.0;

// Dibujamos la tablita en la esquina superior DERECHA de este recuadro.
drawTablaRangosPeq($pdf, $xTablaDer, $y + 2.0, $wTabla);

// (AquÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â en el futuro puedes insertar imagen del plano si quieres)
// $pdf->Image('ruta.png', $L+2, $y+2, $W-4, $hPlano-4);

$y = $y + $hPlano + 2.0;

// ====== TABLA ASISTENCIA ======
headerBar($pdf, $L, $y, $W, 6.0, "Tabla de asistencia en matriz de decisiones.");
$y += 6.0;

$hAsis = 68.0;
rect($pdf, $L, $y, $W, $hAsis);

$m = 1.5;
$ix = $L + $m;
$iy = $y + $m;
$iw = $W - ($m*2);
$ih = $hAsis - ($m*2);

$tableW = $iw * 0.62;
$gap    = 2.0;
$warnW  = $iw - $tableW - $gap;

drawDecisionMatrix($pdf, $ix, $iy, $tableW, $ih);
drawWarningBox($pdf, $ix + $tableW + $gap, $iy, $warnW, $ih);

// (Tu imagen ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œlimpiaÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â la deja vacÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âa. Si quieres meter la tabla y advertencia, se hace despuÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©s.)
$y = $y + $hAsis + 2.0;

// ====== TOMA CONOCIMIENTO ======
headerBar($pdf, $L, $y, $W, 6.0, "TOMA CONOCIMIENTO DE PLANIFICACION");
$y += 6.0;

$hToma = 18.0;
rect($pdf, $L, $y, $W, $hToma);

// 3 columnas: Cargo | Nombre | Firma
$xCargo = $L + 48.0;
$xNom   = $L + 156.0;
vline($pdf, $xCargo, $y, $y+$hToma);
vline($pdf, $xNom,   $y, $y+$hToma);

// 2 filas en blanco + header row (como se ve abajo)
hline($pdf, $L, $y + 6.0, $R);
hline($pdf, $L, $y + 12.0, $R);

// Encabezados columnas
cellText($pdf, $L, $y+0.9, ($xCargo-$L), 5, "Cargo", 'C', 'B', 8);
cellText($pdf, $xCargo, $y+0.9, ($xNom-$xCargo), 5, "Nombre", 'C', 'B', 8);
cellText($pdf, $xNom, $y+0.9, ($R-$xNom), 5, "Firma", 'C', 'B', 8);

$y = $y + $hToma + 2.0;

// ====== OBSERVACIONES ======
headerBar($pdf, $L, $y, $W, 6.0, "Observaciones");
$y += 6.0;

$hObs = 10.5;
rect($pdf, $L, $y, $W, $hObs);
hline($pdf, $L, $y + $hObs/2, $R);

cellText($pdf, $L+2, $y+0.8, 10, 4.5, "1.-", 'L', 'B', 8);
cellText($pdf, $L+2, $y+($hObs/2)+0.8, 10, 4.5, "2.-", 'L', 'B', 8);

// si quieres imprimir observaciones (resumen) dentro:
$obs = trim((string)($row['observaciones'] ?? ''));
if ($obs !== '') {
  $parts = wrapLines($obs);
  fitCellText($pdf, $L+12, $y+0.8, $W-14, 4.5, $parts[0] ?? '', 'L', '', 7, 6);
  fitCellText($pdf, $L+12, $y+($hObs/2)+0.8, $W-14, 4.5, $parts[1] ?? '', 'L', '', 7, 6);
}

// ===== DEBUG: rejilla simple =====
if ($debug) {
  $pdf->SetDrawColor(255,0,0);
  $pdf->SetLineWidth(0.2);
  for ($gx=0; $gx<=216; $gx+=10) { $pdf->Line($gx, 0, $gx, 279); }
  for ($gy=0; $gy<=356; $gy+=10) { $pdf->Line(0, $gy, 216, $gy); }
  $pdf->SetDrawColor($BLUE[0], $BLUE[1], $BLUE[2]);
  $pdf->SetLineWidth(0.35);
}

// ===== Output =====
$nombre = 'PIV_FORMATO_' . ($row['fecha'] ? date('d-m-Y', strtotime($row['fecha'])) : 'sinf') . '_ID'.$id_piv.'.pdf';
$pdf->Output('I', $nombre);
exit;

