// ===== Helpers =====
function rect($pdf, $x, $y, $w, $h, $fill=false){
  $pdf->Rect($x, $y, $w, $h, $fill ? 'F' : '');
}
function hline($pdf, $x1,$y,$x2){ $pdf->Line($x1,$y,$x2,$y); }
function vline($pdf, $x,$y1,$y2){ $pdf->Line($x,$y1,$x,$y2); }

function cellText($pdf, $x, $y, $w, $h, $text, $align='L', $style='', $fs=8){
  $pdf->SetFont('Helvetica', $style, $fs);
  $pdf->SetXY($x,$y);
  $pdf->Cell($w,$h, htxt($text), 0, 0, $align);
}

function fitCellText($pdf, $x, $y, $w, $h, $text, $align='L', $style='', $base=8, $min=6){
  $text = trim((string)$text);
  $fs = $base;
  $pdf->SetFont('Helvetica', $style, $fs);
  while ($fs > $min && $pdf->GetStringWidth(htxt($text)) > ($w-1.0)) {
    $fs -= 0.5;
    $pdf->SetFont('Helvetica', $style, $fs);
  }
  if ($pdf->GetStringWidth(htxt($text)) > ($w-1.0)) {
    while ($text !== '' && $pdf->GetStringWidth(htxt($text.'...')) > ($w-1.0)) {
      $text = substr($text, 0, -1);
    }
    $text .= '...';
  }
  cellText($pdf, $x, $y, $w, $h, $text, $align, $style, $fs);
}

function wrapWordsToLines($pdf, $text, $maxW, $fontFamily='Helvetica', $style='', $fs=7, $maxLines=2){
  $text = trim((string)$text);
  if ($text === '') return [''];

  $pdf->SetFont($fontFamily, $style, $fs);
  $words = preg_split('/\s+/', $text);
  $lines = [];
  $current = '';

  foreach ($words as $w) {
    $test = ($current === '') ? $w : ($current . ' ' . $w);
    if ($pdf->GetStringWidth(htxt($test)) <= $maxW) {
      $current = $test;
    } else {
      if ($current === '') {
        $cut = $w;
        while ($cut !== '' && $pdf->GetStringWidth(htxt($cut.'...')) > $maxW) {
          if (function_exists('mb_substr') && function_exists('mb_strlen')) {
            $cut = mb_substr($cut, 0, mb_strlen($cut)-1);
          } else {
            $cut = substr($cut, 0, -1);
          }
        }
        $lines[] = $cut;
        $current = '';
      } else {
        $lines[] = $current;
        $current = $w;
      }
    }
    if (count($lines) >= $maxLines) break;
  }

  if (count($lines) < $maxLines && $current !== '') $lines[] = $current;

  if (count($lines) === $maxLines) {
    $last = $lines[$maxLines-1];
    if ($pdf->GetStringWidth(htxt($last)) > $maxW) {
      while ($last !== '' && $pdf->GetStringWidth(htxt($last.'...')) > $maxW) {
        if (function_exists('mb_substr') && function_exists('mb_strlen')) {
          $last = mb_substr($last, 0, mb_strlen($last)-1);
        } else {
          $last = substr($last, 0, -1);
        }
      }
    }
    $lines[$maxLines-1] = rtrim($last);
  }

  return $lines;
}

function labelCellWrap($pdf, $x0, $y0, $w, $h, $text){
  $base = 7.0;
  $min  = 5.6;

  for ($fs = $base; $fs >= $min; $fs -= 0.2) {
    $pdf->SetFont('Helvetica', 'B', $fs);
    if ($pdf->GetStringWidth(htxt($text)) <= ($w - 1.0)) {
      $pdf->SetXY($x0, $y0);
      $pdf->Cell($w, $h, htxt($text), 0, 0, 'L');
      return;
    }
  }

  $fs = 6.0;
  $pdf->SetFont('Helvetica', 'B', $fs);
  $lines = wrapWordsToLines($pdf, $text, $w - 1.0, 'Helvetica', 'B', $fs, 2);

  $lineH = $h / 2;
  $startY = $y0 + 0.2;
  $pdf->SetXY($x0, $startY);
  $pdf->Cell($w, $lineH, htxt($lines[0] ?? ''), 0, 2, 'L');
  $pdf->Cell($w, $lineH, htxt($lines[1] ?? ''), 0, 2, 'L');
}

function headerBar($pdf, $x, $y, $w, $h, $title){
  global $FILL, $BLUE;
  $pdf->SetFillColor($FILL[0], $FILL[1], $FILL[2]);
  rect($pdf, $x, $y, $w, $h, true);
  $pdf->SetDrawColor($BLUE[0], $BLUE[1], $BLUE[2]);
  $pdf->Rect($x, $y, $w, $h);
  cellText($pdf, $x, $y+0.7, $w, $h, $title, 'C', 'B', 8.5);
}

function wrapTextToLines($pdf, $text, $maxW, $font='Helvetica', $style='', $fs=7.2){
  $text = trim((string)$text);
  if ($text === '') return [''];

  $pdf->SetFont($font, $style, $fs);

  $words = preg_split('/\s+/', $text);
  $lines = [];
  $line = '';

  foreach ($words as $w) {
    $test = ($line === '') ? $w : ($line.' '.$w);
    if ($pdf->GetStringWidth(htxt($test)) <= $maxW) {
      $line = $test;
    } else {
      if ($line !== '') $lines[] = $line;
      $line = $w;
    }
  }
  if ($line !== '') $lines[] = $line;

  return $lines;
}

function fitMultiTextToBox($pdf, $x, $y, $w, $h, $text, $font='Helvetica', $style='', $baseFs=7.2, $minFs=6.0, $lineH=3.6){
  // Intenta bajando fuente hasta que quepa en alto
  for ($fs = $baseFs; $fs >= $minFs; $fs -= 0.2) {
    $lines = wrapTextToLines($pdf, $text, $w, $font, $style, $fs);
    $needH = count($lines) * $lineH;
    if ($needH <= $h) {
      $pdf->SetFont($font, $style, $fs);
      $pdf->SetXY($x, $y);
      foreach ($lines as $ln) {
        $pdf->Cell($w, $lineH, htxt($ln), 0, 2, 'L');
      }
      return;
    }
  }

  // Si aun asi no cabe: recorta con "..."
  $fs = $minFs;
  $pdf->SetFont($font, $style, $fs);
  $lines = wrapTextToLines($pdf, $text, $w, $font, $style, $fs);

  $maxLines = (int)floor($h / $lineH);
  $lines = array_slice($lines, 0, max(1,$maxLines));

  // agrega "..." al final si recortamos
  $last = end($lines);
  $last = rtrim($last);
  while ($last !== '' && $pdf->GetStringWidth(htxt($last.'...')) > $w) {
    $last = substr($last, 0, -1);
  }
  $lines[count($lines)-1] = $last.'...';

  $pdf->SetXY($x, $y);
  foreach ($lines as $ln) {
    $pdf->Cell($w, $lineH, htxt($ln), 0, 2, 'L');
  }
}

function fitMultiTextToBoxCentered($pdf, $x, $y, $w, $h, $text, $font='Helvetica', $style='', $baseFs=7.2, $minFs=6.0, $lineH=3.6){
  for ($fs = $baseFs; $fs >= $minFs; $fs -= 0.2) {
    $lines = wrapTextToLines($pdf, $text, $w, $font, $style, $fs);
    $needH = count($lines) * $lineH;
    if ($needH <= $h) {
      $pdf->SetFont($font, $style, $fs);
      $startY = $y + ($h - $needH)/2;
      $pdf->SetXY($x, $startY);
      foreach ($lines as $ln) {
        $pdf->Cell($w, $lineH, htxt($ln), 0, 2, 'C');
      }
      return;
    }
  }

  // fallback: recorta con ...
  $fs = $minFs;
  $pdf->SetFont($font, $style, $fs);
  $lines = wrapTextToLines($pdf, $text, $w, $font, $style, $fs);

  $maxLines = (int)floor($h / $lineH);
  $lines = array_slice($lines, 0, max(1,$maxLines));

  $last = rtrim(end($lines));
  while ($last !== '' && $pdf->GetStringWidth(htxt($last.'...')) > $w) {
    $last = substr($last, 0, -1);
  }
  $lines[count($lines)-1] = $last.'...';

  $needH = count($lines)*$lineH;
  $startY = $y + ($h - $needH)/2;
  $pdf->SetXY($x, $startY);
  foreach ($lines as $ln) {
    $pdf->Cell($w, $lineH, htxt($ln), 0, 2, 'C');
  }
}

function drawFillCell($pdf, $x, $y, $w, $h, $txt, $fillRGB = null, $border=1, $align='C', $fs=7, $bold=false){
  // Fondo + borde
  $pdf->SetXY($x,$y);
  $pdf->SetDrawColor(0,70,140);

  if ($fillRGB) {
    $pdf->SetFillColor($fillRGB[0], $fillRGB[1], $fillRGB[2]);
    // texto blanco si es fondo oscuro
    if ($fillRGB[0] < 120 && $fillRGB[1] < 120) $pdf->SetTextColor(255,255,255);
    else $pdf->SetTextColor(0,0,0);
    $pdf->Rect($x,$y,$w,$h,'DF'); // Draw+Fill
  } else {
    $pdf->SetTextColor(0,0,0);
    $pdf->Rect($x,$y,$w,$h,'D');  // Draw
  }

  // Texto con ajuste automÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡tico
  $style = $bold ? 'B' : '';
  $pad = 1.2;

  // Si es texto largo o tiene saltos, lo ajustamos al cuadro (nunca se sale)
  $needsWrap = (strpos($txt, "\n") !== false) || (strlen($txt) > 18);

  if ($needsWrap) {
    // IMPORTANTE: fitMultiTextToBox escribe alineado a la izquierda; lo dejamos con un padding para que se vea bien.
    // (Si quieres centrado real lÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Ânea a lÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Ânea tambiÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©n se puede, pero asÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ya no se sale nunca.)
    fitMultiTextToBox(
      $pdf,
      $x + $pad,
      $y + 0.6,
      $w - ($pad*2),
      $h - 1.2,
      $txt,
      'Helvetica',
      $style,
      $fs,
      max(5.6, $fs-1.4),
      3.2
    );
  } else {
    $pdf->SetFont('Helvetica', $style, $fs);
    $pdf->SetXY($x,$y);
    $pdf->Cell($w,$h, htxt($txt), 0, 0, $align, false);
  }

  // Reset
  $pdf->SetTextColor(0,0,0);
}

function drawTablaRangosPeq($pdf, $x, $y, $w) {
  $cHead   = [230, 230, 230];
  $c1 = [123, 255, 46];   // verde claro
  $c2 = [0, 128, 0];      // verde
  $c3 = [128, 128, 0];    // oliva
  $c4 = [255, 140, 0];    // naranjo
  $c5 = [132, 132, 189];  // lila
  $c6 = [255, 0, 0];      // rojo
  $c7 = [128, 0, 0];      // rojo oscuro
  $c8 = [0, 0, 0];        // negro

  $hRow = 3.8;
  $cw = [$w * 0.25, $w * 0.35, $w * 0.40];

  drawFillCell($pdf, $x, $y, $w, $hRow, "Rangos de Pendientes", $cHead, 1, 'C', 6.2, true);
  $yy = $y + $hRow;

  drawFillCell($pdf, $x, $yy, $cw[0], $hRow, "Color", $cHead, 1, 'C', 5.8, true);
  drawFillCell($pdf, $x + $cw[0], $yy, $cw[1], $hRow, "Porcentaje (%)", $cHead, 1, 'C', 5.8, true);
  drawFillCell($pdf, $x + $cw[0] + $cw[1], $yy, $cw[2], $hRow, "Grados (°)", $cHead, 1, 'C', 5.8, true);
  $yy += $hRow;

  $rows = [
    [$c1, "0 a 30",   "0,00 a 16,70"],
    [$c2, "30 a 40",  "16,70 a 21,80"],
    [$c3, "40 a 50",  "21,80 a 26,57"],
    [$c4, "50 a 60",  "26,57 a 30,96"],
    [$c5, "60 a 70",  "30,96 a 34,99"],
    [$c6, "70 a 90",  "34,99 a 41,99"],
    [$c7, "90 a 100", "41,99 a 45,00"],
    [$c8, "100 +",    "45 +"]
  ];

  foreach ($rows as $r) {
    $pdf->SetFillColor($r[0][0], $r[0][1], $r[0][2]);
    $pdf->Rect($x, $yy, $cw[0], $hRow, 'DF');
    $pdf->Rect($x, $yy, $cw[0], $hRow, 'D');

    drawFillCell($pdf, $x + $cw[0], $yy, $cw[1], $hRow, $r[1], null, 1, 'C', 6.2);
    drawFillCell($pdf, $x + $cw[0] + $cw[1], $yy, $cw[2], $hRow, $r[2], null, 1, 'C', 6.2);

    $yy += $hRow;
  }
}

function drawDecisionMatrix($pdf, $x, $y, $w, $h){
  // Colores (muy parecidos a la imagen)
  $cGreen  = [118, 190,  70];
  $cYellow = [255, 235,  90];
  $cRed    = [235,  55,  55];
  $cHead   = [230, 230, 230];
  $cPend   = [235, 235, 120]; // amarillo "Pendiente"

  // Datos EXACTOS de tu imagen:
  // %min, %max, gmin, gmax, seco, humedo, saturado/rocoso
  $rows = [
    ['0','10','0','6',    ['No asistir',$cGreen],  ['No asistir',$cGreen],  ['No asistir',$cGreen]],
    ['11','20','6','11',  ['No asistir',$cGreen],  ['No asistir',$cGreen],  ['Evaluar',$cYellow]],
    ['21','30','12','16', ['No asistir',$cGreen],  ['No asistir',$cGreen],  ['Asistir 50',$cRed]],
    ['31','40','17','22', ['No asistir',$cGreen],  ['Asistir 50',$cRed],    ['Asistir 70',$cRed]],
    ['41','50','23','26', ['Asistir 50',$cRed],    ['Asistir 85',$cRed],    ['Asistir 120',$cRed]],
    ['51','60','27','30', ['Asistir 80',$cRed],    ['Asistir 120',$cRed],   ['Asistir 140',$cRed]],
    ['61','70','31','35', ['Asistir 135',$cRed],   ['Asistir 140',$cRed],   ['Asistir 150',$cRed]],
    ['71','84','35','40', ['Asistir 150',$cRed],   ['Asistir 150',$cRed],   ['Asistir 150',$cRed]],
    ['85','98','40','44', ['Asistir 150',$cRed],   ['Asistir 150',$cRed],   ['Asistir 150',$cRed]],
    ['100','130','45','52',['Asistir 150',$cRed],  ['Asistir 150',$cRed],   ['Asistir 150',$cRed]],
  ];

  // Layout columnas (como la foto)
  // %min | %max | gmin | gmax | seco | humedo | saturado/rocoso
  $col = [0.08, 0.08, 0.08, 0.08, 0.23, 0.23, 0.22];
  $cw = array_map(function($p) use ($w){ return $w * $p; }, $col);

  // Alturas
  $hTitle1 = $h * 0.12;     // tÃtulo grande arriba
  $hTitle2 = 0;             // ya no se usa (lo movemos)
  $hHeader = $h * 0.18;     // un poquito mÃ¡s alto para el bloque kN
  $hSub    = $h * 0.12;     // aquÃ irÃ¡n Suelo Seco / hÃºmedo / rocoso
  $dataH   = $h - ($hTitle1+$hTitle2+$hHeader+$hSub);
  $rh      = $dataH / max(1, count($rows));

  // ===== TÃtulos superiores =====
  drawFillCell($pdf, $x, $y, $w, $hTitle1,
    "Propuesta nueva Matriz de decisiones para equipo T-WINCH 30.2 (kN)",
    $cHead, 1, 'C', 7.1, true
  );

  // ===== Header columnas =====
  $yy = $y + $hTitle1; // ojo: ya no usamos hTitle2
  $xx = $x;

  // Pendiente (abarca 4 columnas)
  drawFillCell($pdf, $xx, $yy, $cw[0]+$cw[1]+$cw[2]+$cw[3], $hHeader,
    "Pendiente",
    $cPend, 1, 'C', 7.2, true
  );
  $xx += $cw[0]+$cw[1]+$cw[2]+$cw[3];

  // Bloque grande kN (abarca 3 columnas de suelos)
  drawFillCell($pdf, $xx, $yy, $cw[4]+$cw[5]+$cw[6], $hHeader,
    "kN necesarios en volteo segÃºn condiciones de suelo, humedad y roca para equipo T-WINCH 30.2 (kN)",
    $cPend, 1, 'C', 6.4, true
  );

  // ===== Subheader =====
  $yy = $yy + $hHeader;
  $xx = $x;

  drawFillCell($pdf, $xx, $yy, $cw[0]+$cw[1], $hSub, "Rangos de porcentaje\n%", null, 1, 'C', 6.8, false);
  $xx += ($cw[0]+$cw[1]);

  drawFillCell($pdf, $xx, $yy, $cw[2]+$cw[3], $hSub, "Grados", null, 1, 'C', 6.8, false);
  $xx += ($cw[2]+$cw[3]);

  drawFillCell($pdf, $xx, $yy, $cw[4], $hSub, "Suelo Seco", $cHead, 1, 'C', 6.6, true);  $xx += $cw[4];
  drawFillCell($pdf, $xx, $yy, $cw[5], $hSub, "Suelo hÃºmedo", $cHead, 1, 'C', 6.6, true); $xx += $cw[5];
  drawFillCell($pdf, $xx, $yy, $cw[6], $hSub, "Suelo saturado/Manto\nrocoso", $cHead, 1, 'C', 6.1, true);

  // ===== Filas de datos =====
  $yy = $yy + $hSub;

  foreach($rows as $r){
    $xx = $x;

    drawFillCell($pdf, $xx, $yy, $cw[0], $rh, $r[0], null, 1, 'C', 6.8); $xx += $cw[0];
    drawFillCell($pdf, $xx, $yy, $cw[1], $rh, $r[1], null, 1, 'C', 6.8); $xx += $cw[1];
    drawFillCell($pdf, $xx, $yy, $cw[2], $rh, $r[2], null, 1, 'C', 6.8); $xx += $cw[2];
    drawFillCell($pdf, $xx, $yy, $cw[3], $rh, $r[3], null, 1, 'C', 6.8); $xx += $cw[3];

    drawFillCell($pdf, $xx, $yy, $cw[4], $rh, $r[4][0], $r[4][1], 1, 'C', 6.8, true); $xx += $cw[4];
    drawFillCell($pdf, $xx, $yy, $cw[5], $rh, $r[5][0], $r[5][1], 1, 'C', 6.8, true); $xx += $cw[5];
    drawFillCell($pdf, $xx, $yy, $cw[6], $rh, $r[6][0], $r[6][1], 1, 'C', 6.8, true);

    $yy += $rh;
  }

  $pdf->SetTextColor(0,0,0);
}

function drawWarningBox($pdf, $x, $y, $w, $h){

  // Fondo beige
  $pdf->SetFillColor(243, 233, 219);
  $pdf->Rect($x, $y, $w, $h, 'F');

  $orange = [226, 135, 15];
  $gray   = [95,95,95];

  // MÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡rgenes internos
  $pad = 3.0;

  // ==== Icono triÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ngulo ====
  $triW = min(16, $w * 0.22);
  $triH = $triW * 0.92;

  $cx = $x + $pad + ($triW/2);
  $cy = $y + ($h * 0.42);

  $pdf->SetDrawColor($orange[0], $orange[1], $orange[2]);
  $pdf->SetLineWidth(1.0);

  $x1 = $cx;              $y1 = $cy - ($triH/2);
  $x2 = $cx - ($triW/2);   $y2 = $cy + ($triH/2);
  $x3 = $cx + ($triW/2);   $y3 = $cy + ($triH/2);

  $pdf->Line($x1,$y1,$x2,$y2);
  $pdf->Line($x2,$y2,$x3,$y3);
  $pdf->Line($x3,$y3,$x1,$y1);

  // "!"
  $pdf->SetTextColor($orange[0], $orange[1], $orange[2]);
  $pdf->SetFont('Helvetica','B',16);
  $pdf->SetXY($cx-2.8, $cy-7.0);
  $pdf->Cell(6,12,'!',0,0,'C');

  // ==== TÃƒÆ’Ã†â€™Ãƒâ€Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âtulo ====
  $titleX = $x + $pad + $triW + 3.5;
  $titleY = $y + $pad + 1.0;

  $pdf->SetFont('Helvetica','B',10);
  $pdf->SetXY($titleX, $titleY);
  $pdf->Cell($w - ($titleX - $x) - $pad, 5, htxt("Advertencia"), 0, 0, 'L');

  // ==== Texto (auto-ajustado al alto) ====
  $txt = "El uso adecuado de las tensiones debe estar relacionado con la pendiente y los puntos de contacto del cable de acero. Cabe destacar que el equipo es capaz de tensar el cable hasta un lÃƒÆ’Ã‚Âmite de 150 kN (aproximadamente 15 toneladas). A partir de este punto, si se requiere mayor tracciÃƒÆ’Ã‚Â³n, la tecnologÃƒÆ’Ã‚Âa del sistema de asistencia ajusta automÃƒÆ’Ã‚Â¡ticamente la tensiÃƒÆ’Ã‚Â³n segÃƒÆ’Ã‚Âºn las necesidades operativas del equipo, especialmente cuando se supera una fuerza de 150 kN, asegurando asÃƒÆ’Ã‚Â la seguridad del sistema.";

  $textX = $titleX;
  $textY = $titleY + 6.0;

  $textW = $w - ($textX - $x) - $pad;
  $bottomPad = 5.0; // aire extra para que no se vea ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œcortadoÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â
  $textH = $h - ($textY - $y) - $bottomPad;

  $pdf->SetTextColor($gray[0], $gray[1], $gray[2]);

  // Nunca se sale del cuadro
  fitMultiTextToBox($pdf, $textX, $textY, $textW-1.5, $textH, $txt, 'Helvetica', '', 7.2, 5.2, 3.2);

  // Reset
  $pdf->SetTextColor(0,0,0);
  $pdf->SetDrawColor(0,70,140);
  $pdf->SetLineWidth(0.35);
}

function wrapLines($text){
  $text = trim((string)$text);
  if ($text === '') return [];
  $raw = preg_split('/\r\n|\r|\n/', $text);
  $out = [];
  foreach ($raw as $l){
    $l = trim(preg_replace('/^[\-\*\x{2022}]+\s*/u', '', (string)$l));
    if ($l !== '') $out[] = $l;
  }
  return $out;
}

